<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings for the XPlat Code Coverage collector; command lines are in README, section Tests. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Source-generated code (OpenAPI XML comments, Regex, LoggerMessage) is not ours to test. -->
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <Include>[ScoringApi]*,[ScoringApi.Core]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
